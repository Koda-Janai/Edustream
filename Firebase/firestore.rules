rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esPropietario(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function leccionExiste(id) {
      return id is string && exists(/databases/$(database)/documents/lessons/$(id));
    }

    match /lessons/{lessonId} {
      allow read: if request.auth != null;
    }

    match /users/{uid}/lessonProgress/{lessonId} {
      allow read: if esPropietario(uid);
      allow create: if esPropietario(uid) && leccionExiste(lessonId)
        && request.resource.data.keys().hasOnly(['completedAt'])
        && request.resource.data.completedAt == request.time;
    }

    match /users/{uid}/readingProgress/{lessonId} {
      function posicionValida() {
        return esPropietario(uid) && leccionExiste(lessonId)
          && request.resource.data.keys().hasOnly(['position'])
          && request.resource.data.position is int
          && request.resource.data.position > 0;
      }

      allow read: if esPropietario(uid);
      allow create: if posicionValida();
      allow update: if posicionValida() && request.resource.data.position > resource.data.position;
    }

    match /users/{uid}/quizAttempts/{attemptId} {
      allow read: if esPropietario(uid);
      allow create: if esPropietario(uid)
        && request.resource.data.keys().hasOnly(['lessonId', 'answer', 'submittedAt'])
        && leccionExiste(request.resource.data.lessonId)
        && request.resource.data.answer is int
        && request.resource.data.answer >= 0
        && request.resource.data.answer <
          get(/databases/$(database)/documents/lessons/$(request.resource.data.lessonId)).data.opciones.size()
        && request.resource.data.submittedAt == request.time;
    }
  }
}
